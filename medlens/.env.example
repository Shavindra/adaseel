# Local MEDLENS configuration. Copy to .env; real .env files are gitignored.

MEDLENS_RUNS_DIR=runs

# Shared default runtime for all four agents.
MEDLENS_PROVIDER=openrouter
MEDLENS_MODEL=nvidia/nemotron-nano-9b-v2:free
# MEDLENS_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=replace-locally
# GROQ_API_KEY=replace-locally

# Optional independent role overrides.
# MEDLENS_REPORT_CLASSIFICATION_PROVIDER=groq
# MEDLENS_REPORT_CLASSIFICATION_MODEL=qwen/qwen3-32b
# MEDLENS_RESULT_EXTRACTION_PROVIDER=ollama
# MEDLENS_RESULT_EXTRACTION_MODEL=qwen3.5
# MEDLENS_RESULT_VALIDATION_PROVIDER=ollama
# MEDLENS_RESULT_VALIDATION_MODEL=qwen3.5
# MEDLENS_RESULT_FLAGGING_PROVIDER=ollama
# MEDLENS_RESULT_FLAGGING_MODEL=qwen3.5

# Default false. DEBUG=true records full observable agent/tool inputs and outputs,
# including source text, exact values, schemas, structured model responses, paths,
# errors, and stack traces after recursive secret redaction. Do not share it.
DEBUG=false
