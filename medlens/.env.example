# MEDLENS local configuration example.
#
# Copy this file to either:
#   .env             (repo root), or
#   medlens/.env     (MEDLENS project directory)
# MEDLENS loads it automatically. Real .env files are gitignored.

# Default: hosted OpenRouter + Nemotron.
MEDLENS_PROVIDER=openrouter
MEDLENS_BASE_URL=https://openrouter.ai/api/v1
MEDLENS_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Alternative OpenRouter Qwen preset/model id:
# MEDLENS_MODEL=qwen/qwen3-30b-a3b:free

# Local Ollama examples; no API key is required.
# MEDLENS_PROVIDER=ollama
# MEDLENS_BASE_URL=http://localhost:11434/v1
# MEDLENS_MODEL=qwen3.5
# MEDLENS_MODEL=nemotron-3-nano

# Groq Qwen example; Groq has no Nemotron preset in this project.
# MEDLENS_PROVIDER=groq
# MEDLENS_BASE_URL=https://api.groq.com/openai/v1
# MEDLENS_MODEL=qwen/qwen3-32b
# GROQ_API_KEY=gsk-replace-me
