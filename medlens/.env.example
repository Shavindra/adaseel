# Local MEDLENS configuration. Copy to .env; real .env files are gitignored.

MEDLENS_RUNS_DIR=runs

# Default false. With DEBUG=true, events.jsonl includes full observable stage
# inputs/outputs (including OCR/transcript text, exact values, and local paths)
# after recursive secret redaction. Do not share a debug trace.
DEBUG=false

# Future model/research endpoint variables may be added when those runbook stages
# are implemented. The current review command does not use a model or API key.
